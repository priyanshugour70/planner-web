# Option A: single URL (recommended)
# URL-encode special characters in the password (e.g. @ -> %40)
DATABASE_URL=postgresql://postgres.ayxaottfnzoshqhjdezs:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# Option B: discrete variables (same as Supabase “Transaction pooler”)
# PGHOST=aws-1-ap-southeast-1.pooler.supabase.com
# PGPORT=6543
# PGUSER=postgres.ayxaottfnzoshqhjdezs
# PGPASSWORD=your_password
# PGDATABASE=postgres

# Optional: cap pool size per server instance (default 10)
# PG_POOL_MAX=10

# If migrations failed part-way (e.g. audit_logs missing): pnpm db:repair
# Or apply all files tolerantly: pnpm db:migrate:continue

# Auth — JWT signing (min 32 characters; use a long random secret in production)
JWT_SECRET=replace-with-at-least-32-characters-secret-key
JWT_ISSUER=planner-web
JWT_AUDIENCE=planner-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_COST=12

# Optional: comma-separated browser origins for CORS (default *)
# CORS_ORIGINS=http://localhost:3000

# Optional: append to OTP hashing (defaults to JWT_SECRET)
# OTP_PEPPER=

# Local QA only — never enable in production
# SHOW_DEV_OTP=true
